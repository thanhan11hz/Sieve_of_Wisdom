<?xml version="1.0" encoding="utf-8"?>

<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/registerFragment">

<!--    REGISTER-->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.sieve_of_wisdom.ui.auth.register.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">

        <!-- REGISTER ot LOGIN -->
        <action
            android:id="@+id/action_registerFragment_to_signInFragment"
            app:destination="@id/signInFragment" />

        <!-- REGISTER to HOME -->
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment" />

    </fragment>

<!--    LOGIN-->
    <fragment
        android:id="@+id/signInFragment"
        android:name="com.example.sieve_of_wisdom.ui.auth.sign_in.SignInFragment"
        android:label="Sign In"
        tools:layout="@layout/fragment_sign_in">

        <!-- LOGIN → REGISTER -->

        <action
            android:id="@+id/action_signInFragment_to_registerFragment"
            app:destination="@id/registerFragment" />

            <!-- LOGIN → HOME -->

            <action
                android:id="@+id/action_signInFragment_to_homeFragment"
                app:destination="@id/homeFragment" />

        </fragment>

<!--    HOME-->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.sieve_of_wisdom.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
    android:id="@+id/storeFragment"
    android:name="com.example.sieve_of_wisdom.ui.store.StoreFragment"
    android:label="Store"
    tools:layout="@layout/fragment_store" />


    <fragment
    android:id="@+id/pvpFragment"
    android:name="com.example.sieve_of_wisdom.ui.pvp.PvpFragment"
    android:label="PvP"
    tools:layout="@layout/fragment_pvp" />
</navigation>
