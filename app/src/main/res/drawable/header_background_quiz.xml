<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Black Drop Shadow Layer (Bottom-Right Offset) -->
    <item
        android:top="6dp"
        android:left="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Main Mint Green Box with Black Border -->
    <item
        android:bottom="6dp"
        android:right="6dp">
        <shape android:shape="rectangle">
            <!-- Mint Green Fill Color -->
            <solid android:color="#80E8AC" />

            <!-- Thick Black Outline -->
            <stroke
                android:width="3dp"
                android:color="#000000" />
        </shape>
    </item>

</layer-list>