<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Black offset/shadow -->
    <item
        android:left="3dp"
        android:top="4dp">

        <shape>
            <solid android:color="#000000"/>
        </shape>

    </item>

    <!-- White box -->
    <item
        android:right="3dp"
        android:bottom="4dp">

        <shape>

            <solid android:color="#FFFFFF"/>

            <stroke
                android:width="2dp"
                android:color="#000000"/>

        </shape>

    </item>

</layer-list>