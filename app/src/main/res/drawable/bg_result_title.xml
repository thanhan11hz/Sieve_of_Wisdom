<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Black shadow -->
    <item
        android:left="3dp"
        android:top="5dp">

        <shape>
            <solid android:color="#000000"/>
        </shape>

    </item>

    <!-- Yellow box -->
    <item
        android:right="3dp"
        android:bottom="5dp">

        <shape>

            <solid android:color="#FFD32F"/>

            <stroke
                android:width="4dp"
                android:color="#000000"/>

        </shape>

    </item>

</layer-list>