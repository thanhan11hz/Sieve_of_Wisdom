<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hard shadow -->
    <item
        android:left="4dp"
        android:top="5dp">

        <shape>
            <solid android:color="#000000" />

            <corners android:radius="12dp" />
        </shape>

    </item>

    <!-- Main card -->
    <item
        android:right="4dp"
        android:bottom="5dp">

        <shape>

            <solid android:color="#FFFFFF" />

            <stroke
                android:width="3dp"
                android:color="#000000" />

            <corners
                android:radius="12dp" />

        </shape>

    </item>

</layer-list>