<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Black drop shadow layer offset bottom and right -->
    <item
        android:top="4dp"
        android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/black" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- Outer black border / container -->
    <item
        android:bottom="4dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/black" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- White background inside border -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="4dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- Yellow progress fill -->
    <item
        android:id="@android:id/progress"
        android:top="2dp"
        android:left="2dp"
        android:right="4dp"
        android:bottom="6dp">
        <clip android:clipOrientation="horizontal">
            <shape android:shape="rectangle">
                <solid android:color="@color/progress_yellow" />
                <corners android:radius="100dp" />
            </shape>
        </clip>
    </item>

</layer-list>