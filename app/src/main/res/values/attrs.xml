<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- ================================================= -->
    <!-- SHARED NEO ATTRIBUTES -->
    <!-- ================================================= -->

    <attr
        name="neoShadowColor"
        format="color" />

    <attr
        name="neoShadowX"
        format="dimension" />

    <attr
        name="neoShadowY"
        format="dimension" />

    <attr
        name="neoStrokeColor"
        format="color" />

    <attr
        name="neoStrokeWidth"
        format="dimension" />


    <!-- ================================================= -->
    <!-- NEO TEXT VIEW -->
    <!-- ================================================= -->

    <declare-styleable name="NeoTextView">

        <!-- Standard TextView attributes -->

        <attr name="android:text" />
        <attr name="android:textColor" />
        <attr name="android:textSize" />
        <attr name="android:textStyle" />
        <attr name="android:fontFamily" />
        <attr name="android:gravity" />

        <!-- Shared Neo attributes -->

        <attr name="neoShadowColor" />
        <attr name="neoShadowX" />
        <attr name="neoShadowY" />

        <attr name="neoStrokeColor" />
        <attr name="neoStrokeWidth" />

    </declare-styleable>


    <!-- ================================================= -->
    <!-- NEO FRAME LAYOUT -->
    <!-- ================================================= -->

    <declare-styleable name="NeoFrameLayout">

        <!-- Shared Neo attributes -->

        <attr name="neoShadowColor" />
        <attr name="neoShadowX" />
        <attr name="neoShadowY" />

        <attr name="neoStrokeColor" />
        <attr name="neoStrokeWidth" />

        <!-- NeoFrameLayout specific -->

        <attr
            name="neoBackgroundColor"
            format="color" />

        <attr
            name="neoCornerRadius"
            format="dimension" />

    </declare-styleable>

</resources>