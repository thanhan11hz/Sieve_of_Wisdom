<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:id="@+id/quiz_package_root"
    android:layout_width="match_parent"
    android:layout_height="165dp"
    android:layout_marginBottom="15dp"

    android:clipChildren="false"
    android:clipToPadding="false">


    <!-- ===================================================== -->
    <!-- HARD SHADOW -->
    <!-- ===================================================== -->

    <View
        android:id="@+id/quiz_package_shadow"
        android:layout_width="match_parent"
        android:layout_height="160dp"

        android:translationX="4dp"
        android:translationY="5dp"

        android:background="@drawable/bg_quiz_package_shadow" />


    <!-- ===================================================== -->
    <!-- MAIN CARD -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/quiz_package_card"
        android:layout_width="match_parent"
        android:layout_height="160dp"

        android:background="@drawable/bg_quiz_package"

        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"

        android:paddingBottom="10dp">


        <!-- ==================== TITLE ==================== -->

        <TextView
            android:id="@+id/tv_package_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:fontFamily="@font/roboto"
            android:text="Lịch sử Việt Nam"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- ==================== QUESTIONS ==================== -->

        <LinearLayout
            android:id="@+id/questionInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chat"
                android:scaleType="fitCenter"
                android:contentDescription="Số câu hỏi" />

            <TextView
                android:id="@+id/tv_package_questions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/roboto"
                android:text="30 câu hỏi"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

        </LinearLayout>


        <!-- ==================== TIME ==================== -->

        <LinearLayout
            android:id="@+id/durationInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_clock"
                android:scaleType="fitCenter"
                android:contentDescription="Thời gian" />

            <TextView
                android:id="@+id/tv_package_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/roboto"
                android:text="60 giây"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

        </LinearLayout>




        <!-- ==================== BOTTOM ROW ==================== -->

        <LinearLayout
            android:id="@+id/package_bottom_row"
            android:layout_width="match_parent"
            android:layout_height="45dp"

            android:layout_marginTop="8dp"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- ==================== START BUTTON ==================== -->

            <FrameLayout
                android:id="@+id/package_start_button"
                android:layout_width="128dp"
                android:layout_height="47dp"

                android:clipChildren="false"
                android:clipToPadding="false">


                <!-- BUTTON SHADOW -->

                <View
                    android:id="@+id/package_start_button_shadow"
                    android:layout_width="125dp"
                    android:layout_height="43dp"

                    android:background="@drawable/bg_neo_shadow_button"
                    android:translationX="3dp"
                    android:translationY="3dp" />

                <!-- BUTTON -->

                <TextView
                    android:id="@+id/btn_package_start"
                    android:layout_width="125dp"
                    android:layout_height="43dp"

                    android:background="@drawable/bg_neo_button"

                    android:clickable="true"
                    android:focusable="true"

                    android:fontFamily="@font/roboto"
                    android:gravity="center"
                    android:text="Bắt đầu"
                    android:textColor="@color/black"

                    android:textSize="17sp"
                    android:textStyle="bold" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>