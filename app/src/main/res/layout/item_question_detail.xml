<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/questionItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="0dp">

    <!-- Neo shadow -->
<!--    <View-->
<!--        android:id="@+id/questionItemShadow"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        android:layout_marginStart="4dp"-->
<!--        android:layout_marginTop="4dp"-->
<!--            android:background="@drawable/bg_neo_shadow_button" />-->

    <!-- Main card -->


    <LinearLayout
        android:id="@+id/questionItemContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/bg_neo_question_correct">

        <!-- Question number -->

        <com.example.sieve_of_wisdom.ui.neo.NeoTextView
            android:id="@+id/tvQuestionNumber"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Câu 1"
            android:textColor="@color/white"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFamily="@font/roboto"

            app:neoShadowColor="@color/black"
            app:neoShadowX="7dp"
            app:neoShadowY="3dp"

            app:neoStrokeColor="@color/black"
            app:neoStrokeWidth="3dp"
            android:includeFontPadding="false"
            />
        <!-- Question -->
        <com.example.sieve_of_wisdom.ui.neo.NeoTextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Thủ đô Việt Nam nằm ở đâu?"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/itim"

            app:neoShadowColor="@color/black"
            app:neoShadowX="0dp"
            app:neoShadowY="0dp"

            app:neoStrokeColor="@color/black"
            app:neoStrokeWidth="3dp"
            android:includeFontPadding="false"
            />
<!--        <TextView-->
<!--            android:id="@+id/tvQuestion"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginTop="12dp"-->
<!--            android:fontFamily="@font/itim"-->
<!--            android:text="Thủ đô Việt Nam nằm ở đâu?"-->
<!--            android:textColor="@color/black"-->
<!--            android:textSize="17sp"-->
<!--            android:textStyle="bold"-->
<!--            android:includeFontPadding="false" />-->

        <!-- Correct answer -->
        <com.example.sieve_of_wisdom.ui.neo.NeoTextView
            android:id="@+id/tvCorrectAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Đáp án: Hà Nội"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/itim"

            app:neoShadowColor="@color/black"
            app:neoShadowX="0dp"
            app:neoShadowY="0dp"

            app:neoStrokeColor="@color/black"
            app:neoStrokeWidth="0dp"
            android:includeFontPadding="false"
            />
<!--        <TextView-->
<!--            android:id="@+id/tvCorrectAnswer"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginTop="8dp"-->
<!--            android:fontFamily="@font/itim"-->
<!--            android:text="Đáp án: Hà Nội"-->
<!--            android:textColor="@color/black"-->
<!--            android:textSize="15sp"-->
<!--            android:textStyle="bold"-->
<!--            android:includeFontPadding="false" />-->

        <!-- User answer -->
        <com.example.sieve_of_wisdom.ui.neo.NeoTextView
            android:id="@+id/tvUserAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bạn trả lời: Hà Nội"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/itim"

            app:neoShadowColor="@color/black"
            app:neoShadowX="0dp"
            app:neoShadowY="0dp"

            app:neoStrokeColor="@color/black"
            app:neoStrokeWidth="0dp"
            android:includeFontPadding="false"
            />
<!--        <TextView-->
<!--            android:id="@+id/tvUserAnswer"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginTop="4dp"-->
<!--            android:fontFamily="@font/itim"-->
<!--            android:text="Bạn trả lời: Hà Nội"-->
<!--            android:textColor="@color/black"-->
<!--            android:textSize="15sp"-->
<!--            android:textStyle="bold"-->
<!--            android:includeFontPadding="false" />-->

    </LinearLayout>

</FrameLayout>