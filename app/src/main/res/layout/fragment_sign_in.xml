<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/login_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_signin"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/login_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingTop="70dp"
            android:paddingEnd="14dp"
            android:paddingBottom="30dp">

            <!-- ==================== TITLE ==================== -->

            <com.example.sieve_of_wisdom.ui.neo.NeoTextView
                android:id="@+id/tv_login_title"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:text="Đăng nhập"
                android:textColor="@color/white"
                android:textSize="55sp"
                android:textStyle="bold"
                android:fontFamily="@font/itim"

                app:neoShadowColor="@color/primary_yellow"
                app:neoShadowX="4dp"
                app:neoShadowY="5dp"

                app:neoStrokeColor="@color/black"
                app:neoStrokeWidth="5dp"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- ==================== USERNAME ==================== -->

            <TextView
                android:id="@+id/tv_username_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/roboto"
                android:text="Tên đăng nhập"
                android:textColor="@color/black"
                android:textSize="25sp"
                android:textStyle="bold"
                android:includeFontPadding="true"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_login_title" />

            <!-- USERNAME NEO CONTAINER -->

            <FrameLayout
                android:id="@+id/username_input_container"
                android:layout_width="0dp"
                android:layout_height="49dp"
                android:clipChildren="false"
                android:clipToPadding="false"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_username_label">

                <!-- HARD SHADOW -->

                <View
                    android:id="@+id/username_input_shadow"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:translationX="5dp"
                    android:translationY="5dp"
                    android:background="@drawable/bg_neo_shadow" />

                <!-- MAIN INPUT -->

                <EditText
                    android:id="@+id/et_username"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_neo_input"
                    android:fontFamily="@font/roboto"
                    android:gravity="center_vertical"
                    android:hint="Nhập tên đăng nhập"
                    android:includeFontPadding="false"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/input_hint"
                    android:textSize="14sp" />

            </FrameLayout>


            <!-- ==================== PASSWORD ==================== -->

            <com.example.sieve_of_wisdom.ui.neo.NeoTextView
                android:id="@+id/tv_password_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"

                android:text="Mật khẩu"
                android:textColor="@color/black"
                android:textSize="25sp"
                android:textStyle="bold"
                android:fontFamily="@font/roboto"

                app:neoStrokeColor="@color/black"
                app:neoStrokeWidth="0dp"

                app:neoShadowColor="@color/white"
                app:neoShadowX="0dp"
                app:neoShadowY="0dp"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/username_input_container" />


            <FrameLayout
                android:id="@+id/password_input_container"
                android:layout_width="0dp"
                android:layout_height="49dp"
                android:layout_marginTop="2dp"
                android:clipChildren="false"
                android:clipToPadding="false"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_password_label">

                <!-- HARD SHADOW -->

                <View
                    android:id="@+id/password_input_shadow"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:translationX="5dp"
                    android:translationY="5dp"
                    android:background="@drawable/bg_neo_shadow" />

                <!-- MAIN INPUT -->

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_neo_input"
                    android:fontFamily="@font/roboto"
                    android:gravity="center_vertical"
                    android:hint="Nhập mật khẩu"
                    android:includeFontPadding="false"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/input_hint"
                    android:textSize="14sp" />

            </FrameLayout>

            <!-- ==================== FORGOT PASSWORD ==================== -->

            <TextView
                android:id="@+id/tv_forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/roboto"
                android:text="Quên mật khẩu?"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:foreground="?attr/selectableItemBackground"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/password_input_container" />
            <!-- ==================== LOGIN BUTTON ==================== -->

            <FrameLayout
                android:id="@+id/login_button_container"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="15dp"
                android:clipChildren="false"
                android:clipToPadding="false"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_forgot_password">

                <!-- HARD SHADOW -->

                <View
                    android:id="@+id/login_button_shadow"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:translationX="5dp"
                    android:translationY="5dp"
                    android:background="@drawable/bg_neo_shadow_button" />

                <!-- MAIN BUTTON -->

                <TextView
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_neo_button"
                    android:fontFamily="@font/itim"
                    android:gravity="center"
                    android:text="Đăng nhập"
                    android:textColor="@color/black"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>


            <!-- ==================== REGISTER FOOTER ==================== -->

            <TextView
                android:id="@+id/tv_register_redirect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-60dp"
                android:fontFamily="@font/roboto"
                android:text="Chưa có tài khoản?  Đăng ký"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:foreground="?attr/selectableItemBackground"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/login_button_container"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- LOADING OVERLAY -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Loading Card -->
        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_loading_card"
            android:elevation="8dp">

            <ProgressBar
                android:id="@+id/progressLoading"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#FFD32F" />

        </FrameLayout>

    </FrameLayout>

</FrameLayout>