<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/quiz_package_root"
    android:layout_width="match_parent"
    android:layout_height="165dp"
    android:layout_marginBottom="15dp"

    android:clipChildren="false"
    android:clipToPadding="false">


    <!-- ===================================================== -->
    <!-- HARD SHADOW -->
    <!-- ===================================================== -->

    <View
        android:id="@+id/quiz_package_shadow"
        android:layout_width="match_parent"
        android:layout_height="160dp"

        android:translationX="4dp"
        android:translationY="5dp"

        android:background="@drawable/bg_quiz_package_shadow" />


    <!-- ===================================================== -->
    <!-- MAIN CARD -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/quiz_package_card"
        android:layout_width="match_parent"
        android:layout_height="160dp"

        android:background="@drawable/bg_quiz_package"

        android:orientation="vertical"

        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">


        <!-- ================================================= -->
        <!-- TITLE + STARS -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/titleStarRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- TITLE -->

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:fontFamily="@font/roboto"
                android:text="Lịch sử Việt Nam"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold" />


            <!-- STARS -->

            <LinearLayout
                android:id="@+id/llStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:gravity="center_vertical"
                android:orientation="horizontal">


                <com.example.sieve_of_wisdom.ui.neo.NeoTextView
                    android:id="@+id/tv_streak_star"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"

                    android:fontFamily="@font/roboto"
                    android:gravity="center"
                    android:includeFontPadding="false"

                    android:text="★"
                    android:textColor="@color/primary_yellow"
                    android:textSize="15sp"

                    app:neoShadowColor="@color/black"
                    app:neoShadowX="2dp"
                    app:neoShadowY="2dp"

                    app:neoStrokeColor="@color/black"
                    app:neoStrokeWidth="2dp" />


                <TextView
                    android:id="@+id/tvStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="3dp"

                    android:fontFamily="@font/roboto"
                    android:includeFontPadding="false"

                    android:text="15"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- QUESTIONS -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/questionInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"

                android:src="@drawable/ic_chat"
                android:scaleType="fitCenter"
                android:contentDescription="Số câu hỏi" />


            <TextView
                android:id="@+id/tvQuestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="8dp"

                android:fontFamily="@font/roboto"
                android:text="30 câu hỏi"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"

                android:includeFontPadding="false" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- DURATION -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/durationInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:gravity="center_vertical"
            android:orientation="horizontal">


<!--            <ImageView-->
<!--                android:layout_width="20dp"-->
<!--                android:layout_height="20dp"-->
<!--            -->
<!--                android:src="@drawable/ic_clock"-->
<!--                android:scaleType="fitCenter"-->
<!--                android:contentDescription="Thời gian" />-->


            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="8dp"

                android:fontFamily="@font/roboto"
                android:text=""
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"

                android:includeFontPadding="false" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- BOTTOM ROW -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/package_bottom_row"
            android:layout_width="match_parent"
            android:layout_height="45dp"

            android:layout_marginTop="8dp"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- ================================================= -->
            <!-- START BUTTON -->
            <!-- ================================================= -->


            <!-- ================================================= -->
            <!-- UNLOCK BUTTON -->
            <!-- ================================================= -->

            <FrameLayout
                android:id="@+id/btnUnlock"
                android:layout_width="128dp"
                android:layout_height="47dp"

                android:layout_marginStart="8dp"

                android:visibility="gone"

                android:clipChildren="false"
                android:clipToPadding="false"

                tools:visibility="visible">


                <!-- UNLOCK SHADOW -->

                <View
                    android:layout_width="125dp"
                    android:layout_height="43dp"

                    android:background="@drawable/bg_neo_shadow_button"

                    android:translationX="3dp"
                    android:translationY="3dp" />


                <!-- UNLOCK BUTTON -->

                <TextView
                    android:id="@+id/tvBtnUnlock"
                    android:layout_width="125dp"
                    android:layout_height="43dp"

                    android:background="@drawable/bg_button_unlock"

                    android:clickable="false"
                    android:focusable="false"

                    android:fontFamily="@font/roboto"
                    android:gravity="center"

                    android:text="Mở khóa?"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- BANNER -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/bannerContainer"

        android:layout_width="259dp"
        android:layout_height="52dp"

        android:layout_gravity="bottom|end"

        android:rotation="-40"

        android:clipChildren="false"
        android:clipToPadding="false"

        android:translationX="55dp"
        android:translationY="1dp">


        <!-- BLACK BORDER -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:background="@color/black">


            <!-- ================================================= -->
            <!-- UNLOCKED -->
            <!-- ================================================= -->

            <com.example.sieve_of_wisdom.ui.neo.NeoTextView
                android:id="@+id/tvBannerUnLocked"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:layout_margin="3dp"

                android:background="#A8E52C"

                android:gravity="center"

                android:paddingStart="60dp"
                android:paddingTop="10dp"
                android:paddingBottom="0dp"
                android:fontFamily="@font/roboto"
                android:text="ĐÃ MỞ KHÓA"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"

                app:neoShadowColor="@color/black"
                app:neoShadowX="2dp"
                app:neoShadowY="2dp"

                app:neoStrokeColor="@color/black"
                app:neoStrokeWidth="2dp"

                android:includeFontPadding="false" />


            <!-- ================================================= -->
            <!-- LOCKED -->
            <!-- ================================================= -->

            <com.example.sieve_of_wisdom.ui.neo.NeoTextView
                android:id="@+id/tvBannerLocked"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:layout_margin="3dp"

                android:background="#FF4D4D"

                android:gravity="center"

                android:paddingStart="60dp"

                android:fontFamily="@font/roboto"
                android:text="ĐÃ KHÓA"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="10dp"
                android:paddingBottom="0dp"
                app:neoShadowColor="@color/black"
                app:neoShadowX="2dp"
                app:neoShadowY="2dp"

                app:neoStrokeColor="@color/black"
                app:neoStrokeWidth="2dp"

                android:includeFontPadding="false"

                android:visibility="gone"

                tools:visibility="visible" />

        </FrameLayout>

    </FrameLayout>

</FrameLayout>